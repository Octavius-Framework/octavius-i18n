{
  "hello": "Hello",
  "welcome": "Welcome {name}",
  "users": {
    "active": "Active users",
    "count": {
      "$plural": "count",
      "=0": "No users",
      "one": "{count} user",
      "other": "{count} users"
    },
    "purchased": {
      "$plural": "count",
      "one": "{name} bought {count} item",
      "other": "{name} bought {count} items"
    },
    "joined": "{name} joined",
    "invited": {
      "$plural": "count",
      "=0": "{name} invited nobody",
      "one": "{name} invited {count} friend",
      "other": "{name} invited {count} friends"
    },
    "finished": {
      "$ordinal": "place",
      "one": "{name} finished {place}st",
      "two": "{name} finished {place}nd",
      "few": "{name} finished {place}rd",
      "other": "{name} finished {place}th"
    }
  },
  "composition": {
    "bought": {
      "$plural": "count",
      "one": "{count} man bought {what}",
      "other": "{count} men bought {what}"
    },
    "apples": {
      "$plural": "count",
      "one": "1 apple",
      "other": "{count} apples"
    },
    "sentence": "{who} bought {what}"
  },
  "pay": "Total: {price, number}"
}
