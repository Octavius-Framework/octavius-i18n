{
  "hello": "Cześć",
  "welcome": "Witaj {name}",
  "users": {
    "active": "Aktywni użytkownicy",
    "count": {
      "$plural": "count",
      "one": "{count} użytkownik",
      "few": "{count} użytkowników",
      "many": "{count} użytkowników",
      "other": "{count} użytkowników"
    },
    "purchased": {
      "$plural": "count",
      "one": "{name} kupił {count} przedmiot",
      "few": "{name} kupił {count} przedmioty",
      "many": "{name} kupił {count} przedmiotów",
      "other": "{name} kupił {count} przedmiotów"
    },
    "joined": {
      "$select": "gender",
      "female": "{name} dołączyła",
      "other": "{name} dołączył"
    },
    "invited": {
      "$select": "gender",
      "female": {
        "$plural": "count",
        "=0": "{name} nikogo nie zaprosiła",
        "one": "{name} zaprosiła {count} znajomego",
        "few": "{name} zaprosiła {count} znajomych",
        "many": "{name} zaprosiła {count} znajomych",
        "other": "{name} zaprosiła {count} znajomego"
      },
      "other": {
        "$plural": "count",
        "=0": "{name} nikogo nie zaprosił",
        "one": "{name} zaprosił {count} znajomego",
        "few": "{name} zaprosił {count} znajomych",
        "many": "{name} zaprosił {count} znajomych",
        "other": "{name} zaprosił {count} znajomego"
      }
    },
    "finished": "{name} zajął {place}. miejsce"
  },
  "composition": {
    "bought": {
      "$plural": "count",
      "one": "{count} mężczyzna kupił {what}",
      "few": "{count} mężczyzn kupiło {what}",
      "many": "{count} mężczyzn kupiło {what}",
      "other": "{count} mężczyzny kupiło {what}"
    },
    "apples": {
      "$plural": "count",
      "one": "1 jabłko",
      "few": "{count} jabłka",
      "many": "{count} jabłek",
      "other": "{count} jabłek"
    },
    "sentence": "{who} kupił {what}"
  }
}
